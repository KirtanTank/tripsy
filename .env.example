# Required: builds the itineraries. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: nicer photos from Unsplash. Without it, photos come from Wikimedia Commons.
UNSPLASH_ACCESS_KEY=

# Optional: live road traffic in the Rush meter. Without either, the road lane shows the crowd forecast as an estimate.
# Mapbox (preferred): drive time on the real route now vs a typical day. Token at https://account.mapbox.com
MAPBOX_TOKEN=
# Safety cap on Mapbox requests per month (the free tier is 100,000). Defaults to 50000.
MAPBOX_MONTHLY_CAP=
# TomTom (fallback): traffic flow sampled along the way. Free key at https://developer.tomtom.com
TOMTOM_API_KEY=

# Optional: Postgres for saved trips and share links (Neon, Supabase or any Postgres).
# Without it, an embedded Postgres keeps them in .data/db. Set this when deploying.
DATABASE_URL=

# Optional: Redis for the API cache (https://upstash.com). Without it, the cache uses files in .cache/api.
# Set these when deploying to a serverless host. Vercel's KV_REST_API_URL / KV_REST_API_TOKEN also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
